        "en": "Slot interface station",
        "es": "Posición de las interfaces de ranura",
        "fr": "Position des interfaces de rainure",
        "pt": "Posição das interfaces de ranhura"
      },
      "default": 10,
      "min": 0,
      "max": 2000,
      "unit": "mm",
      "note": "Where the slot interfaces sit, measured from each end. A convention, not a fact: 10 mm puts them under a 20 mm wide bracket flush with the end. Keep it at most length_mm / 2."
    },
    {
      "id": "blind_station_mm",
      "type": "number",
      "label": {
        "en": "Blind-joint station",
        "es": "Posición de las uniones ciegas",
        "fr": "Position des assemblages borgnes",
        "pt": "Posição das juntas cegas"
      },
      "default": 10,
      "min": 0,
      "max": 2000,
      "unit": "mm",
      "source": 1,
      "note": "Where the blind-joint stations sit on each face, measured from each end. The default 10 is half the 20 mm profile (cited): a partner extrusion butted on the station then has its outer face flush with this end, as at a frame corner. Elsewhere it is a convention; keep it between 10 and length_mm − 10 so the partner's end lies on the face."
    }
