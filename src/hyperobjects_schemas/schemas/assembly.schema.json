{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://madfam.io/schemas/assembly.schema.json",
  "title": "Hyperobjects type-level assembly (assembly.json)",
  "description": "ASM-1 §2. A type-level assembly: which components (commons cartridges at given parameters, keystone standard parts, or external designs declared by name, licence and URL) are mated at which interfaces. One component entry is one physical instance. The structure is checked here; `y4d-spec assembly check` resolves every component, places it, and checks every mate (ASM-1 §3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "slug", "kind", "name", "license", "root", "components", "mates"],
  "properties": {
    "format": { "const": "hyperobjects.assembly" },
    "format_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 96 },
    "kind": {
      "enum": ["producer", "product"],
      "description": "`producer`: a fabrication machine model; `product`: a thing that is made."
    },
    "name": { "$ref": "#/$defs/i18nString" },
    "description": { "$ref": "#/$defs/i18nString" },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX identifier of THIS document's licence (e.g. CERN-OHL-W-2.0). Each external component carries its own."
    },
    "root": {
      "$ref": "#/$defs/componentId",
      "description": "The component placed at the world origin (T_root = I)."
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "mates": {
      "type": "array",
      "items": { "$ref": "#/$defs/mate" }
    },
    "capability_profile": {
      "type": "object",
      "description": "Producers only: what the machine can fabricate, keyed by the `fabrication-capabilities` vocabulary (SEM-1 §4). Vocabulary membership is a lexicon rule, not a schema rule.",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "properties": {
        "process": {
          "description": "The processes the machine performs: a LIST of `processes` keys, like `requirements.process` (SEM-1 §2.4). Settled in hyperobjects-spec 0.5.0 (P4-ASM2 finding 5); a bare string is refused.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requirements_rollup": {
      "type": "boolean",
      "description": "Products: roll the fabricated components' `requirements` up into the assembly's requirement profile (ASM-1 §5)."
    },
    "machine": { "$ref": "#/$defs/machine" },
    "paths": {
      "type": "array",
      "description": "ASM-1 §9 (v1.3). Declared paths through components, such as a belt around its pulleys and idlers. A path is not a component: it places nothing, and the validator checks it against the placed components.",
      "items": { "$ref": "#/$defs/path" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "product" } }, "required": ["kind"] },
      "then": { "not": { "required": ["capability_profile"] } }
    }
  ],
  "$defs": {
    "i18nString": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "es": { "type": "string", "minLength": 1 },
        "fr": { "type": "string", "minLength": 1 },
        "pt": { "type": "string", "minLength": 1 }
      }
    },
    "componentId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/componentId" },
        "label": { "$ref": "#/$defs/i18nString" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["cartridge", "standard", "external"] } },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "cartridge" } } },
          "then": { "$ref": "#/$defs/cartridgeSource" }
        },
        {
          "if": { "properties": { "type": { "const": "standard" } } },
          "then": { "$ref": "#/$defs/standardSource" }
        },
        {
          "if": { "properties": { "type": { "const": "external" } } },
          "then": { "$ref": "#/$defs/externalSource" }
        }
      ]
    },
    "parameterValues": {
      "type": "object",
      "description": "Parameter values over the defaults (GOC-1 full injection). Every key must be a declared parameter and every value in range; an out-of-range value is an error, never clamped.",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": ["number", "boolean", "string"] }
    },
    "cartridgeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "commons", "slug", "mode"],
      "properties": {
        "type": { "const": "cartridge" },
        "commons": {
          "enum": ["solid"],
          "description": "Only the solid commons declares 3-D interface frames (SEM-1 §3: soft interfaces are 2-D seams)."
        },
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "mode": { "type": "string", "minLength": 1 },
        "part": { "type": ["string", "null"], "minLength": 1 },
        "parameters": { "$ref": "#/$defs/parameterValues" }
      }
    },
    "standardSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key"],
      "properties": {
        "type": { "const": "standard" },
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "parameters": { "$ref": "#/$defs/parameterValues" }
      }
    },
    "externalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "license", "url", "interfaces"],
      "description": "A third-party design referenced by name, licence and URL, with its interface facts declared inline. No CAD is vendored.",
      "properties": {
        "type": { "const": "external" },
        "name": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "revision": {
          "type": "string",
          "minLength": 1,
          "description": "Optional upstream tag or commit the interface facts were taken from."
        },
        "interfaces": { "type": "array", "items": { "$ref": "#/$defs/externalInterface" } }
      }
    },
    "numericVector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "externalInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frame", "polarity", "size_key", "symmetry"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "$ref": "#/$defs/i18nString" },
        "geometry_type": { "type": "string", "minLength": 1 },
        "standard": { "type": "string", "minLength": 1 },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "normal"],
          "properties": {
            "part": { "type": "string", "minLength": 1 },
            "origin": { "$ref": "#/$defs/numericVector" },
            "normal": { "$ref": "#/$defs/numericVector" },
            "x_axis": { "$ref": "#/$defs/numericVector" }
          }
        },
        "polarity": { "enum": ["male", "female", "neutral"] },
        "size_key": { "type": "string", "minLength": 1 },
        "symmetry": { "type": "integer", "enum": [0, 1, 2, 3, 4, 6, 8] }
      },
      "if": { "properties": { "symmetry": { "not": { "const": 0 } } } },
      "then": { "properties": { "frame": { "required": ["x_axis"] } } }
    },
    "interfaceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "interface"],
      "properties": {
        "component": { "$ref": "#/$defs/componentId" },
        "interface": { "type": "string", "minLength": 1 }
      }
    },
    "mate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "a", "b"],
      "description": "Interface `a` of one component mated to interface `b` of another. Exactly one of `rotation_index` (symmetry >= 1) or `angle_deg` (continuous symmetry, 0) states the rotation of b about the mated normal.",
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$", "maxLength": 64 },
        "a": { "$ref": "#/$defs/interfaceRef" },
        "b": { "$ref": "#/$defs/interfaceRef" },
        "rotation_index": { "type": "integer", "minimum": 0, "maximum": 7 },
        "angle_deg": { "type": "number", "minimum": -360, "maximum": 360 },
        "joint": { "$ref": "#/$defs/joint" }
      },
      "oneOf": [
        { "required": ["rotation_index"], "not": { "required": ["angle_deg"] } },
        { "required": ["angle_deg"], "not": { "required": ["rotation_index"] } }
      ]
    },
    "jointId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "axis"],
      "description": "ASM-1 §9 (v1.3). Makes the mate a one-degree-of-freedom joint. The mate's frames coincide at joint value 0; at value q the child (side b) is displaced from the parent (side a) by q along (`prismatic`, mm) or about (`revolute`, degrees, right-handed) the named axis of side a's interface frame (`z` is that frame's normal). Placement: T_b = T_a · H(F_a) · J(q) · Flip · Rz(θ) · H(F_b)^-1.",
      "properties": {
        "id": { "$ref": "#/$defs/jointId" },
        "type": { "enum": ["prismatic", "revolute"] },
        "axis": { "enum": ["x", "y", "z"] },
        "limits": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" },
          "description": "[lower, upper], lower < upper, in mm (prismatic) or degrees (revolute). Required for a prismatic joint; a revolute joint without limits is continuous."
        },
        "home": {
          "type": "number",
          "description": "The joint value at the home pose, inside `limits`. Required for a driven joint; a follower's home is computed and a passive joint's is measured, so neither states one."
        },
        "passive": {
          "type": "boolean",
          "description": "true: the joint's value is not set but measured. The mate never places a component (it only closes a cycle), and its value must stay inside `limits` at every pose."
        },
        "follows": {
          "type": "object",
          "additionalProperties": false,
          "required": ["terms"],
          "description": "The joint is a follower: its value is offset + Σ scale · value(joint). Used for coupled drives (ASM-1 §9, owner decision D2: the four Z drives follow one logical Z joint).",
          "properties": {
            "terms": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["joint", "scale"],
                "properties": {
                  "joint": { "$ref": "#/$defs/jointId" },
                  "scale": { "type": "number" }
                }
              }
            },
            "offset": { "type": "number" }
          }
        },
        "note": { "type": "string", "minLength": 1, "description": "Where the limits and home come from (a citation, or a labelled convention)." }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "prismatic" } } }, "then": { "required": ["limits"] } },
        {
          "if": { "properties": { "passive": { "const": true } }, "required": ["passive"] },
          "then": { "not": { "anyOf": [{ "required": ["home"] }, { "required": ["follows"] }] } }
        },
        { "if": { "required": ["follows"] }, "then": { "not": { "required": ["home"] } } },
        {
          "if": {
            "not": {
              "anyOf": [
                { "required": ["follows"] },
                { "properties": { "passive": { "const": true } }, "required": ["passive"] }
              ]
            }
          },
          "then": { "required": ["home"] }
        }
      ]
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kinematics", "axes"],
      "description": "ASM-1 §9 (v1.3). Producers: how a machine's reported axis positions pose the twin. Each bound joint's value is scale · axis + offset (identity by default).",
      "properties": {
        "kinematics": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "The kinematics class, named as the machine's firmware names it (Klipper `[printer] kinematics`: cartesian, corexy, corexz, delta, …)."
        },
        "axes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["axis", "joint"],
            "properties": {
              "axis": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 16 },
              "joint": { "$ref": "#/$defs/jointId" },
              "scale": { "type": "number" },
              "offset": { "type": "number" },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "pathVia": {
      "oneOf": [
        { "$ref": "#/$defs/componentId" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["component"],
          "properties": {
            "component": { "$ref": "#/$defs/componentId" },
            "wrap": { "enum": ["ccw", "cw"] },
            "side": { "enum": ["teeth", "back"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["component", "interface"],
          "properties": {
            "component": { "$ref": "#/$defs/componentId" },
            "interface": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "part", "via", "closed"],
      "properties": {
        "id": { "$ref": "#/$defs/jointId" },
        "kind": { "enum": ["belt"] },
        "part": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "The standard-parts catalog key of the belt (category `belt`)."
        },
        "via": {
          "type": "array",
          "minItems": 2,
          "description": "In order of travel. A component id, or {component, wrap, side}, is a pulley or idler with a cited `belt_engagement`; the belt wraps it counter-clockwise (`ccw`, the default) or clockwise seen from the path normal, with its `teeth` (the default) or its `back` on it. A toothed part takes only the teeth. {component, interface} is an anchor (a belt clamp), allowed only as the first and last via of an open path.",
          "items": { "$ref": "#/$defs/pathVia" }
        },
        "closed": { "type": "boolean" },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
