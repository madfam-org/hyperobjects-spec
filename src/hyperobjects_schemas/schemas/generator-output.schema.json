{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://madfam.io/schemas/generator-output.schema.json",
  "title": "Hyperobjects generator output (variables.json)",
  "description": "GOC-1. The exact inputs, provenance and file digests of one generator instance. Physical (material, process, slicer, printer) settings are forbidden here; they belong to the semantic layer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "kind", "generator", "variables", "variables_sha256", "complete", "geometry", "instance_id"],
  "properties": {
    "format": { "const": "hyperobjects.generator-output" },
    "format_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "kind": { "enum": ["solid", "soft"] },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "cartridge", "mode", "engine", "source"],
      "properties": {
        "platform": { "enum": ["yantra4d", "fashion-cabinet", "hyperobjects-spec"] },
        "platform_build": { "type": "string", "minLength": 1, "maxLength": 128 },
        "cartridge": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "cartridge_version": { "type": "string", "maxLength": 64 },
        "commons": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo"],
          "properties": {
            "repo": { "enum": ["solid-hyperobjects", "soft-hyperobjects"] },
            "sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
          }
        },
        "mode": { "type": "string", "minLength": 1 },
        "part": { "type": ["string", "null"] },
        "engine": { "enum": ["openscad", "cadquery", "graph", "implicit", "fc"] },
        "kernel": { "type": "string", "maxLength": 200 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tree_sha256"],
          "properties": {
            "tree_sha256": { "$ref": "#/$defs/sha256" },
            "tree_algorithm": { "const": "hyperobjects-tree-v1" },
            "entry": { "type": "string" },
            "entry_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "description": "Every manifest-declared parameter of the cartridge (no mode scoping), sorted by id (bytewise). Values keep the type the engine received: slider -> number, checkbox -> boolean, select -> the JSON type of the chosen option value (string or number), text -> string.",
      "items": { "$ref": "#/$defs/variable" }
    },
    "variables_sha256": { "$ref": "#/$defs/sha256" },
    "complete": {
      "type": "boolean",
      "description": "true when every declared parameter was injected into the engine (no source_default entries)."
    },
    "derived": {
      "type": "object",
      "description": "Values computed by the generator or by expressions (G-EXPR, FC solved values). Never inputs; excluded from variables_sha256 and instance_id."
    },
    "legacy_physical_inputs": {
      "type": "object",
      "description": "DEPRECATED. Physical values a platform still injects behind a legacy flag (yantra4d RENDER_MATERIAL_INJECTION, target_material). Recorded for truthfulness; checkers warn. Excluded from variables_sha256 and instance_id.",
      "additionalProperties": { "type": ["number", "string", "boolean"] }
    },
    "geometry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "media_type": { "type": "string", "minLength": 3 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 },
          "units": { "enum": ["mm"] },
          "role": { "enum": ["primary", "viewer", "auxiliary"] }
        }
      }
    },
    "instance_id": { "$ref": "#/$defs/sha256" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "type", "source"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "not": {
            "anyOf": [
              { "enum": ["target_material", "material_profile", "print_material", "filament_type", "infill", "infill_density", "infill_pattern", "layer_height", "first_layer_height", "nozzle_diameter", "nozzle_temperature", "nozzle_temp", "bed_temperature", "bed_temp", "print_speed", "wall_loops", "perimeters", "jerk", "acceleration", "fan_speed", "slicer_profile", "printer_profile"] },
              { "pattern": "^(mat_shrinkage_|mat_clear_|thermo_|slicer_|printer_|filament_)" }
            ]
          }
        },
        "value": { "type": ["number", "boolean", "string", "null"] },
        "type": { "enum": ["number", "boolean", "string"] },
        "source": { "enum": ["request", "preset", "manifest_default", "source_default"] },
        "preset_id": { "type": "string" },
        "unit": { "type": "string" },
        "measurement": { "type": "string", "description": "ISO 8559 landmark code, when the manifest binds one (soft)." }
      },
      "allOf": [
        { "if": { "properties": { "source": { "const": "source_default" } } },
          "then": { "properties": { "value": { "type": "null" } } },
          "else": { "properties": { "value": { "type": ["number", "boolean", "string"] } } } },
        { "if": { "properties": { "source": { "const": "preset" } } }, "then": { "required": ["preset_id"] } }
      ]
    }
  }
}
