    "label": {
     "en": "Fold the switch tab over: the contacts meet (1/6)",
     "es": "Dobla la pestaña del interruptor: los contactos se tocan (1/6)",
     "fr": "Rabattez la languette de l'interrupteur : les contacts se touchent (1/6)",
     "pt": "Dobre a aba do interruptor: os contactos tocam-se (1/6)"
    },
    "note": {
     "en": "Circuit closed (cell + → LED 'led' → switch → cell −): the LED lights. Checked by pliego.press.circuit.",
     "es": "Circuito cerrado (cell + → LED 'led' → switch → cell −): el LED se enciende. Comprobado con pliego.press.circuit.",
     "fr": "Circuit fermé (cell + → LED 'led' → switch → cell −) : la LED s'allume. Vérifié par pliego.press.circuit.",
     "pt": "Circuito fechado (cell + → LED 'led' → switch → cell −): o LED acende. Verificado por pliego.press.circuit."
