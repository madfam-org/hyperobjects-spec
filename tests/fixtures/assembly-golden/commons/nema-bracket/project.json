  "estimate_constants": {
    "base_time": 15,
    "per_unit": 4,
    "per_part": 17,
    "fn_factor": 32,
    "wasm_multiplier": 4,
    "warning_threshold_seconds": 90
  },
  "hyperobject": {
    "domain": "industrial",
    "cdg_interfaces": [
      {
        "id": "nema_bolt_pattern",
        "label": {
          "en": "NEMA Bolt Pattern",
          "es": "Patron de Tornillos NEMA"
        },
        "geometry_type": "bolt_pattern",
        "standard": "NEMA 17/23",
        "parameters": [
          "nema",
          "pilot_open"
        ],
        "compatible_with": [
          "motor-mount",
          "scara-robotics"
        ]
      },
      {
        "id": "mount_holes",
        "label": {
          "en": "Mount Holes",
          "es": "Agujeros de Montaje"
        },
        "geometry_type": "bolt_pattern",
        "standard": "internal",
        "parameters": [
          "base_bolt_d",
          "base_len"
        ],
        "compatible_with": [
          "nema-bracket"
        ]
      },
      {
        "id": "flat_bracket_motor_face",
        "label": {
          "en": "Motor face seat (flat bracket)",
          "es": "Asiento de la cara del motor (placa plana)"
        },
        "geometry_type": "bolt_pattern",
        "standard": "NEMA ICS 16 face (frame size 17 / 23), clearance holes, motor on the top face",
        "parameters": ["nema", "plate_t"],
        "frame": {
          "part": "flat_bracket",
          "origin": [0, 0, "plate_t"],
          "normal": [0, 0, 1],
          "x_axis": [1, 0, 0]
        },
        "polarity": "male",
        "size_key": {
          "param": "nema",
          "map": {
            "NEMA17": "nema-17-face",
            "NEMA23": "nema-23-face"
          }
        },
        "symmetry": 4
      },
      {
        "id": "extrusion_mount_foot_slot",
        "label": {
          "en": "Foot seat on the extrusion slot (extrusion mount)",
          "es": "Asiento del pie en la ranura del perfil (montaje a perfil)"
        },
        "geometry_type": "profile",
        "standard": "2020 T-slot extrusion, M5 T-nuts on the slot centre-line",
        "parameters": ["base_len"],
        "frame": {
          "part": "extrusion_mount",
          "origin": [0, 0, 0],
          "normal": [0, 0, -1],
          "x_axis": [1, 0, 0]
        },
        "polarity": "male",
        "size_key": "tslot-2020-6mm",
        "symmetry": 2
      },
      {
        "id": "l_bracket_motor_face",
        "label": {
          "en": "Motor face seat (L-bracket)",
          "es": "Asiento de la cara del motor (escuadra en L)"
        },
        "geometry_type": "bolt_pattern",
        "standard": "NEMA ICS 16 face (frame size 17 / 23), clearance holes, motor on the outer face",
        "parameters": [
          "nema",
          "margin",
          "base_len",
          "base_t",
          "plate_t"
        ],
        "let": {
          "bolt_sq": {
            "param": "nema",
            "map": {
              "NEMA17": 31,
              "NEMA23": 47.14
            }
          },
          "bolt_d": {
            "param": "nema",
            "map": {
              "NEMA17": 3.4,
              "NEMA23": 5.2
            }
          },
          "body_w": {
            "param": "nema",
            "map": {
              "NEMA17": 42.3,
              "NEMA23": 57
            }
          },
          "plate_side": "max(bolt_sq + 2 * (bolt_d / 2 + max(3, margin)), body_w + 4)",
          "axis_z": "plate_side / 2 + max(3, base_t)"
        },
        "frame": {
          "part": "l_bracket",
          "origin": [
            "-base_len / 2",
            0,
            "axis_z"
          ],
          "normal": [
            -1,
            0,
            0
          ],
          "x_axis": [
            0,
            1,
            0
          ]
        },
        "polarity": "male",
        "size_key": {
          "param": "nema",
          "map": {
            "NEMA17": "nema-17-face",
            "NEMA23": "nema-23-face"
          }
        },
        "symmetry": 4
      },
      {
        "id": "extrusion_mount_motor_face",
        "label": {
          "en": "Motor face seat (extrusion mount)",
          "es": "Asiento de la cara del motor (montaje a perfil)"
        },
        "geometry_type": "bolt_pattern",
        "standard": "NEMA ICS 16 face (frame size 17 / 23), clearance holes, motor on the outer face",
        "parameters": [
          "nema",
          "margin",
          "base_len",
          "base_t",
          "plate_t"
        ],
        "let": {
          "bolt_sq": {
            "param": "nema",
            "map": {
              "NEMA17": 31,
              "NEMA23": 47.14
            }
          },
          "bolt_d": {
            "param": "nema",
            "map": {
              "NEMA17": 3.4,
              "NEMA23": 5.2
            }
          },
          "body_w": {
            "param": "nema",
            "map": {
              "NEMA17": 42.3,
              "NEMA23": 57
            }
          },
          "plate_side": "max(bolt_sq + 2 * (bolt_d / 2 + max(3, margin)), body_w + 4)",
          "axis_z": "plate_side / 2 + max(3, base_t)"
        },
        "frame": {
          "part": "extrusion_mount",
          "origin": [
            "-max(base_len, 40) / 2 + max(3, plate_t) / 2",
            0,
            "axis_z"
          ],
          "normal": [
            -1,
            0,
            0
          ],
          "x_axis": [
            0,
            1,
            0
          ]
        },
        "polarity": "male",
        "size_key": {
          "param": "nema",
          "map": {
            "NEMA17": "nema-17-face",
            "NEMA23": "nema-23-face"
          }
        },
        "symmetry": 4
      }
    ],
    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": false,
      "tolerance_by_material": true
    },
    "societal_benefit": {
      "en": "Stepper motors outlive the machines they came in, but every printer, CNC and robot needs the motor held at a different angle. An on-demand NEMA 17/23 bracket cut to the exact bolt square lets a salvaged motor drive a new build without hunting for a proprietary mount.",
      "es": "Los motores a pasos sobreviven a las maquinas de las que vienen, pero cada impresora, CNC y robot necesita sujetar el motor en un angulo distinto. Un soporte NEMA 17/23 bajo demanda cortado al cuadro de tornillos exacto permite que un motor rescatado impulse un nuevo proyecto sin buscar un montaje propietario."
    },
    "commons_license": "CERN-OHL-W-2.0"
  },
  "tags": [
    "nema",
