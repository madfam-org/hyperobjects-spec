        "base_len": 60,
        "plate_t": 6
      }
    }
  ],
  "constraints": [
    {
      "expression": "plate_t >= 3",
      "severity": "error",
      "message": {
        "en": "Motor plate must be at least 3 mm thick",
        "es": "La placa del motor debe tener al menos 3 mm de grosor"
      }
    },
    {
      "expression": "margin >= 3",
      "severity": "warning",
      "message": {
        "en": "A margin under 3 mm leaves thin material at the bolt holes",
        "es": "Un margen menor a 3 mm deja material delgado en los agujeros de tornillo"
      }
    }
  ],
