        "es": "Pie para Extrusion 2020"
      },
      "render_mode": 0,
      "color": "#5c7ba0"
    }
  ],
  "parameter_groups": [
    {
      "id": "motor",
      "label": {
        "en": "Motor",
        "es": "Motor"
      }
    },
    {
      "id": "plate",
      "label": {
        "en": "Plate",
        "es": "Placa"
      }
    },
    {
      "id": "base",
      "label": {
        "en": "Base & Foot",
        "es": "Base y Pie"
      }
    }
  ],
  "parameters": [
    {
      "id": "nema",
      "type": "select",
      "default": "NEMA17",
      "group": "motor",
      "modes": [
        "l_bracket",
        "flat_bracket",
        "extrusion_mount"
      ],
      "label": {
        "en": "NEMA Size",
        "es": "Tamano NEMA"
      },
      "tooltip": {
        "en": "Stepper size — sets the bolt square, bolt size and pilot bore",
        "es": "Tamano del motor — define el cuadro de tornillos, el tornillo y el barreno piloto"
      },
      "options": [
        {
          "value": "NEMA17",
          "label": {
            "en": "NEMA 17 (42.3 mm, 31 mm square, M3)",
            "es": "NEMA 17 (42.3 mm, cuadro 31 mm, M3)"
          }
        },
        {
          "value": "NEMA23",
          "label": {
            "en": "NEMA 23 (57 mm, 47.14 mm square, M4/M5)",
            "es": "NEMA 23 (57 mm, cuadro 47.14 mm, M4/M5)"
          }
        }
      ]
    },
    {
      "id": "pilot_open",
      "type": "checkbox",
      "default": true,
      "group": "motor",
      "modes": [
        "l_bracket",
        "flat_bracket",
        "extrusion_mount"
      ],
      "label": {
        "en": "Pilot Bore",
        "es": "Barreno Piloto"
      },
      "tooltip": {
        "en": "Cut the central bore that clears the motor register boss / shaft",
        "es": "Corta el barreno central que libera el buje de registro / eje del motor"
      }
    },
    {
      "id": "plate_t",
      "type": "slider",
      "unit": "mm",
      "default": 5.0,
      "min": 3.0,
      "max": 10.0,
      "step": 0.5,
      "group": "plate",
      "modes": [
        "l_bracket",
        "flat_bracket",
        "extrusion_mount"
      ],
      "label": {
        "en": "Plate Thickness (mm)",
        "es": "Grosor de Placa (mm)"
      },
      "tooltip": {
        "en": "Motor plate thickness",
        "es": "Grosor de la placa del motor"
      }
    },
    {
      "id": "margin",
      "unit": "mm",
      "type": "slider",
      "default": 6.0,
      "min": 3.0,
      "max": 14.0,
      "step": 0.5,
      "group": "plate",
      "modes": [
        "l_bracket",
        "flat_bracket",
        "extrusion_mount"
      ],
      "label": {
        "en": "Bolt Margin (mm)",
        "es": "Margen de Tornillos (mm)"
      },
      "tooltip": {
        "en": "Material around the motor bolt square",
        "es": "Material alrededor del cuadro de tornillos del motor"
      }
    },
    {
      "id": "base_len",
      "type": "slider",
      "unit": "mm",
      "default": 45.0,
      "min": 25.0,
      "max": 90.0,
      "step": 1,
      "group": "base",
      "modes": [
        "l_bracket",
        "extrusion_mount"
      ],
      "label": {
        "en": "Base / Foot Length (mm)",
        "es": "Largo de Base / Pie (mm)"
      },
      "tooltip": {
        "en": "Length of the horizontal base (L) or extrusion foot",
        "es": "Largo de la base horizontal (L) o del pie de extrusion"
      }
    },
    {
      "id": "base_t",
      "unit": "mm",
      "type": "slider",
      "default": 5.0,
      "min": 3.0,
      "max": 10.0,
      "step": 0.5,
      "group": "base",
      "modes": [
        "l_bracket",
        "extrusion_mount"
      ],
      "label": {
        "en": "Base Thickness (mm)",
        "es": "Grosor de Base (mm)"
      },
      "tooltip": {
        "en": "Base / foot slab thickness",
        "es": "Grosor de la losa de base / pie"
      }
    },
    {
      "id": "base_bolt_d",
      "type": "slider",
      "default": 5.2,
      "min": 3.0,
      "max": 6.5,
      "step": 0.1,
      "group": "base",
      "modes": [
        "l_bracket",
        "flat_bracket",
        "extrusion_mount"
      ],
      "label": {
        "en": "Mount Bolt (mm)",
        "es": "Tornillo de Montaje (mm)"
      },
      "tooltip": {
        "en": "Base / corner mounting bolt clearance (5.2 = M5 T-nut)",
        "es": "Holgura del tornillo de montaje base / esquina (5.2 = tuerca T M5)"
      }
    },
    {
      "id": "gusset",
      "type": "checkbox",
      "default": true,
      "group": "base",
      "modes": [
        "l_bracket",
        "extrusion_mount"
      ],
      "advanced": true,
      "label": {
        "en": "Corner Gusset",
        "es": "Refuerzo de Esquina"
      },
      "tooltip": {
        "en": "Add a triangular gusset to stiffen the plate/base corner",
        "es": "Agrega un refuerzo triangular para rigidizar la esquina placa/base"
      }
    }
  ],
  "presets": [
