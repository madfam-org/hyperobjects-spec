{
  "project": {
    "name": "NEMA Stepper Bracket",
    "slug": "nema-bracket",
    "version": "1.0.0",
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "CERN-OHL-W-2.0"
    },
    "engine": "cadquery",
    "description": {
      "en": "Mounts a NEMA 17 or NEMA 23 stepper motor. The motor face carries the correct square bolt pattern (NEMA 17: 31 mm square, M3; NEMA 23: 47.14 mm square, M4/M5) plus a central pilot bore that clears the motor register boss and shaft. Choose an L-mount, a flat surface plate, or a 2020 T-slot extrusion foot.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Monta un motor a pasos NEMA 17 o NEMA 23. La cara del motor lleva el patron de tornillos cuadrado correcto (NEMA 17: cuadro de 31 mm, M3; NEMA 23: cuadro de 47.14 mm, M4/M5) mas un barreno piloto central que libera el buje de registro y el eje del motor. Elige un soporte en L, una placa plana de superficie o un pie para extrusion 2020 con ranura en T.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/nema-bracket.webp",
    "difficulty": "intermediate",
    "tags": [
      "nema",
      "nema17",
      "nema23",
      "stepper",
      "motor",
      "bracket",
      "cnc",
      "3d-printer",
      "robotics",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
