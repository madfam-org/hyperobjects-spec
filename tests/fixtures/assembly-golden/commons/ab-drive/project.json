      "group": "hand",
      "modes": [
        "ab_drive"
      ],
      "label": {
        "en": "Rear Beam End Inboard (mm)",
        "es": "Extremo de la Viga Trasera (mm)"
      },
      "tooltip": {
        "en": "How far E's end sits inboard of the C centre: half the C centre spacing − 340 / 2; 34 for a 408 spacing",
        "es": "Cuánto queda el extremo de E por dentro del centro del perfil C: la mitad de la separación − 340 / 2; 34 para 408"
      }
    },
    {
      "id": "mirrored",
      "type": "checkbox",
      "default": false,
      "group": "hand",
      "modes": [
