      ],
      "label": {
        "en": "Right-Hand (A) Drive (Mirrored)",
        "es": "Tracción Derecha (A) (Espejo)"
      },
      "tooltip": {
        "en": "Build the right (A) drive: mirrored in x, its pulley, Q and K on the high belt level, S on the low one",
        "es": "Genera la tracción derecha (A): en espejo en x, su polea, Q y K en el nivel alto, S en el bajo"
      }
    }
  ],
