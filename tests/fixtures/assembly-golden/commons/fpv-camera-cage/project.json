{
  "project": {
    "name": "FPV Camera Cage",
    "slug": "fpv-camera-cage",
    "version": "1.0.0",
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "CERN-OHL-W-2.0"
    },
    "engine": "cadquery",
    "description": {
      "en": "Protects and angles a micro FPV camera. The camera drops into a cradle pocket sized to the standard form factor (nano 14 mm, micro 19 mm, mini 21 mm) and tilts to a chosen up-angle, with tabs that bolt to the frame side plates. Choose a full protective cage, an open tilt bracket, or a minimal naked mount.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Protege y angula una camara micro FPV. La camara entra en una cuna dimensionada al formato estandar (nano 14 mm, micro 19 mm, mini 21 mm) y se inclina a un angulo elegido, con pestanas que se atornillan a las placas laterales del cuadro. Elige una jaula protectora completa, un soporte inclinable abierto o una montura minima.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/fpv-camera-cage.webp",
    "difficulty": "intermediate",
    "tags": ["drone", "fpv", "camera", "cage", "tilt", "mount", "rc", "protection", "hyperobject", "commons"],
    "hyperobject": { "is_hyperobject": true },
    "force_backend": true
  },
  "modes": [
    {
      "id": "cage",
      "label": { "en": "Protective Cage", "es": "Jaula Protectora" },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": ["cage"],
      "estimate": { "base_time": 11, "per_unit": 3, "per_part": 13 }
    },
    {
      "id": "tilt_mount",
      "label": { "en": "Tilt Bracket", "es": "Soporte Inclinable" },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": ["tilt_mount"],
      "estimate": { "base_time": 9, "per_unit": 3, "per_part": 11 }
    },
    {
      "id": "naked_mount",
      "label": { "en": "Naked Mount", "es": "Montura Minima" },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": ["naked_mount"],
      "estimate": { "base_time": 7, "per_unit": 2, "per_part": 9 }
    }
  ],
  "parts": [
    { "id": "cage", "label": { "en": "Protective Cage", "es": "Jaula Protectora" }, "render_mode": 0, "color": "#4a90a4" },
    { "id": "tilt_mount", "label": { "en": "Tilt Bracket", "es": "Soporte Inclinable" }, "render_mode": 0, "color": "#357687" },
    { "id": "naked_mount", "label": { "en": "Naked Mount", "es": "Montura Minima" }, "render_mode": 0, "color": "#66aabb" }
  ],
  "parameter_groups": [
    { "id": "camera", "label": { "en": "Camera", "es": "Camara" } },
    { "id": "housing", "label": { "en": "Housing", "es": "Carcasa" } },
    { "id": "mount", "label": { "en": "Frame Mount", "es": "Montura al Cuadro" } }
  ],
  "parameters": [
    {
      "id": "cam_size", "type": "select", "default": "micro",
      "group": "camera", "modes": ["cage", "tilt_mount", "naked_mount"],
      "label": { "en": "Camera Size", "es": "Tamano de Camara" },
      "tooltip": { "en": "FPV camera form factor (nano 14, micro 19, mini 21 mm)", "es": "Formato de camara FPV (nano 14, micro 19, mini 21 mm)" },
      "options": [
        { "value": "nano", "label": { "en": "Nano (14 mm)", "es": "Nano (14 mm)" } },
        { "value": "micro", "label": { "en": "Micro (19 mm)", "es": "Micro (19 mm)" } },
        { "value": "mini", "label": { "en": "Mini (21 mm)", "es": "Mini (21 mm)" } }
      ]
    },
    {
      "id": "tilt", "unit": "deg", "type": "slider", "default": 30.0, "min": 0.0, "max": 55.0, "step": 1,
      "group": "camera", "modes": ["cage", "tilt_mount", "naked_mount"],
      "label": { "en": "Camera Tilt (deg)", "es": "Inclinacion de Camara (grados)" },
      "tooltip": { "en": "Up-tilt angle for the camera (higher = faster flight)", "es": "Angulo de inclinacion hacia arriba (mayor = vuelo mas rapido)" }
    },
    {
      "id": "cam_len", "unit": "mm", "type": "slider", "default": 20.0, "min": 10.0, "max": 30.0, "step": 0.5,
      "group": "camera", "modes": ["cage", "tilt_mount", "naked_mount"],
      "label": { "en": "Camera Length (mm)", "es": "Largo de Camara (mm)" },
      "tooltip": { "en": "Camera body length, lens face to back (micro class 19 x 19 x 20); the pocket takes the whole body", "es": "Largo del cuerpo de la camara, de la cara del lente a la parte trasera (clase micro 19 x 19 x 20); la cuna aloja el cuerpo completo" }
    },
    {
      "id": "lens_hole", "type": "checkbox", "default": true,
      "group": "camera", "modes": ["cage", "tilt_mount", "naked_mount"],
      "label": { "en": "Lens Aperture", "es": "Abertura de Lente" },
      "tooltip": { "en": "Cut an aperture so the lens / focus is reachable", "es": "Corta una abertura para alcanzar el lente / enfoque" }
    },
    {
      "id": "wall", "unit": "mm", "type": "slider", "default": 2.0, "min": 1.0, "max": 4.0, "step": 0.2,
      "group": "housing", "modes": ["cage", "tilt_mount", "naked_mount"],
      "label": { "en": "Wall Thickness (mm)", "es": "Grosor de Pared (mm)" },
      "tooltip": { "en": "Cradle wall thickness", "es": "Grosor de la pared de la cuna" }
    },
    {
      "id": "cam_clear", "unit": "mm", "type": "slider", "default": 0.4, "min": 0.1, "max": 1.0, "step": 0.05,
      "group": "housing", "modes": ["cage", "tilt_mount"], "advanced": true,
      "label": { "en": "Camera Clearance (mm)", "es": "Holgura de Camara (mm)" },
      "tooltip": { "en": "Per-side gap around the camera body", "es": "Espacio por lado alrededor del cuerpo de la camara" }
    },
    {
      "id": "base_h", "unit": "mm", "type": "slider", "default": 6.0, "min": 2.0, "max": 16.0, "step": 0.5,
      "group": "mount", "modes": ["cage", "tilt_mount", "naked_mount"],
      "label": { "en": "Base Height (mm)", "es": "Altura de Base (mm)" },
      "tooltip": { "en": "Mount base height below the cradle", "es": "Altura de la base debajo de la cuna" }
    },
    {
      "id": "mount_width", "unit": "mm", "type": "slider", "default": 24.0, "min": 8.0, "max": 40.0, "step": 0.5,
      "group": "mount", "modes": ["cage", "tilt_mount", "naked_mount"],
      "label": { "en": "Side-Plate Outer Spacing (mm)", "es": "Separacion Exterior de Placas (mm)" },
      "tooltip": { "en": "Distance across the OUTSIDE of the frame's camera side plates; the ears' inner faces sit exactly here (19 mm bay + 2 x 2.5 mm plates = 24)", "es": "Distancia por FUERA de las placas laterales de camara del cuadro; las caras interiores de las orejas quedan justo aqui (hueco de 19 mm + 2 x 2.5 mm = 24)" }
    },
    {
      "id": "tab_thick", "unit": "mm", "type": "slider", "default": 3.0, "min": 1.5, "max": 6.0, "step": 0.5,
      "group": "mount", "modes": ["cage", "tilt_mount", "naked_mount"],
      "label": { "en": "Ear Thickness (mm)", "es": "Grosor de Oreja (mm)" },
      "tooltip": { "en": "Thickness of the two ears that bolt to the side plates", "es": "Grosor de las dos orejas que se atornillan a las placas laterales" }
    },
    {
      "id": "tab_hole_d", "unit": "mm", "type": "slider", "default": 2.2, "min": 1.6, "max": 4.0, "step": 0.1,
      "group": "mount", "modes": ["cage", "tilt_mount", "naked_mount"], "advanced": true,
      "label": { "en": "Ear Screw Hole (mm)", "es": "Agujero de Oreja (mm)" },
      "tooltip": { "en": "Ear screw hole diameter (M2 = 2.2)", "es": "Diametro del agujero de la oreja (M2 = 2.2)" }
    },
    {
      "id": "ear_reach", "unit": "mm", "type": "slider", "default": 12.0, "min": 6.0, "max": 40.0, "step": 0.5,
      "group": "mount", "modes": ["cage", "tilt_mount", "naked_mount"],
      "label": { "en": "Ear Reach (mm)", "es": "Alcance de Oreja (mm)" },
      "tooltip": { "en": "How far behind the housing's pivot the ear screws sit; set it past how far your side plates reach ahead of their camera screw holes (never less than 4 mm behind the tilted housing)", "es": "Cuanto detras del pivote de la carcasa quedan los tornillos de las orejas; ajustalo mas alla de lo que sobresalen tus placas laterales por delante de sus agujeros de camara (nunca menos de 4 mm detras de la carcasa inclinada)" }
    }
  ],
  "presets": [
    {
      "id": "micro_cage_30", "mode": "cage",
      "label": { "en": "Micro Cage 30 deg", "es": "Jaula Micro 30 grados" },
      "values": { "cam_size": "micro", "tilt": 30, "wall": 2.0, "mount_width": 24 }
    },
    {
      "id": "nano_tilt_40", "mode": "tilt_mount",
      "label": { "en": "Nano Tilt 40 deg", "es": "Nano Inclinado 40 grados" },
      "values": { "cam_size": "nano", "tilt": 40, "wall": 1.6, "mount_width": 24 }
    },
    {
      "id": "mini_naked_20", "mode": "naked_mount",
      "label": { "en": "Mini Naked 20 deg", "es": "Mini Minima 20 grados" },
      "values": { "cam_size": "mini", "tilt": 20, "wall": 2.0, "mount_width": 24 }
    },
    {
      "id": "micro_cage_level",
      "mode": "cage",
      "label": {
        "en": "Micro Cage 0 deg",
        "es": "Jaula Micro 0 grados"
      },
      "values": {
        "cam_size": "micro",
        "tilt": 0,
        "mount_width": 24
      }
    },
    {
      "id": "mini_cage_55",
      "mode": "cage",
      "label": {
        "en": "Mini Cage 55 deg (long ears)",
        "es": "Jaula Mini 55 grados (orejas largas)"
      },
      "values": {
        "cam_size": "mini",
        "tilt": 55,
        "mount_width": 24,
        "ear_reach": 20
      }
    }
  ],
  "constraints": [
    {
      "expression": "tilt <= 55",
      "severity": "warning",
      "message": { "en": "Very high tilt angles clip the frame on landing", "es": "Angulos muy altos rozan el cuadro al aterrizar" }
    },
    {
      "expression": "wall >= 1",
      "severity": "error",
      "message": { "en": "Wall must be at least 1 mm", "es": "La pared debe ser de al menos 1 mm" }
    }
  ],
  "camera_views": [
    { "id": "iso", "label": { "en": "Isometric", "es": "Isometrico" }, "position": [60, 60, 55] },
    { "id": "top", "label": { "en": "Top", "es": "Superior" }, "position": [0, 0, 110] },
    { "id": "front", "label": { "en": "Front", "es": "Frontal" }, "position": [0, 110, 20] }
  ],
  "export_formats": ["stl", "3mf", "step", "glb", "gltf", "obj"],
  "estimate_constants": {
    "base_time": 11, "per_unit": 3, "per_part": 13,
    "fn_factor": 32, "wasm_multiplier": 4, "warning_threshold_seconds": 90
  },
  "hyperobject": {
    "domain": "commercial",
    "cdg_interfaces": [
      {
        "id": "fpv_camera_cradle",
        "label": { "en": "FPV Camera Cradle", "es": "Cuna de Camara FPV" },
        "geometry_type": "pocket",
        "standard": "FPV micro/nano cam (nano 14 / micro 19 / mini 21 mm)",
        "parameters": ["cam_size", "cam_clear", "wall"]
      },
      {
        "id": "frame_mount_tabs",
        "label": { "en": "Frame Mount Ears", "es": "Orejas de Montaje" },
        "geometry_type": "bolt_pattern",
        "standard": "internal",
        "parameters": ["mount_width", "tab_thick", "tab_hole_d", "ear_reach"]
      },
      {
        "id": "cage_cradle_floor",
        "label": {
          "en": "Cradle floor (cage)",
          "es": "Fondo de la cuna (jaula)"
        },
        "geometry_type": "pocket",
        "standard": "FPV camera body, nano 14 / micro 19 / mini 21 mm class; the camera's front (lens) face seats on the floor and looks out through the lens aperture",
        "parameters": [
          "cam_size", "cam_len",
          "cam_clear",
          "tilt"
        ],
        "let": {
          "cw": {
            "param": "cam_size",
            "map": {
              "nano": 14,
              "micro": 19,
              "mini": 21
            }
          },
          "pocket_d": "cam_len + 2 * cam_clear",
          "t": "max(0, min(tilt, 55))"
        },
        "frame": {
          "part": "cage",
          "origin": [
            0,
            "-pocket_d * cos(t)",
            "pocket_d * sin(t)"
          ],
          "normal": [
            0,
            "cos(t)",
            "-sin(t)"
          ],
          "x_axis": [
            1,
            0,
            0
          ]
        },
        "polarity": "female",
        "size_key": {
          "param": "cam_size",
          "map": {
            "nano": "fpv-camera-nano-14mm",
            "micro": "fpv-camera-micro-19mm",
            "mini": "fpv-camera-mini-21mm"
          }
        },
        "symmetry": 4
      },
      {
        "id": "tilt_mount_cradle_floor",
        "label": {
          "en": "Cradle floor (tilt bracket)",
          "es": "Fondo de la cuna (soporte inclinable)"
        },
        "geometry_type": "pocket",
        "standard": "FPV camera body, nano 14 / micro 19 / mini 21 mm class; the camera's front (lens) face seats on the floor and looks out through the lens aperture",
