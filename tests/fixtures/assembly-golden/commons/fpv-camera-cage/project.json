            "mini": "fpv-camera-mini-21mm"
          }
        },
        "symmetry": 4
      },
      {
        "id": "cage_ear_left",
        "label": {
          "en": "Ear on the frame's left side plate (cage)",
          "es": "Oreja sobre la placa lateral izquierda del cuadro (jaula)"
        },
        "geometry_type": "bolt_pattern",
        "standard": "FPV frame camera side plate, outer face, on the camera side-screw axis",
        "parameters": [
          "mount_width",
          "ear_reach",
          "cam_size",
          "cam_clear",
          "wall",
          "tilt",
          "tab_hole_d"
        ],
        "let": {
          "cw": {
            "param": "cam_size",
            "map": {
              "nano": 14,
              "micro": 19,
              "mini": 21
            }
          },
          "t": "max(0, min(tilt, 55))",
          "out_h": "cw + 2 * cam_clear + 2 * wall",
          "bar": "max(1.4, wall * 0.7)",
          "ear_y": "max(ear_reach, out_h / 2 * sin(t) + bar * cos(t) + 4)"
        },
        "frame": {
          "part": "cage",
          "origin": [
            "mount_width / 2",
            "ear_y",
            0
          ],
          "normal": [
