{
  "project": {
    "name": "Dual Block",
    "slug": "dual-block",
    "version": "1.0.0",
    "engine": "openscad",
    "description": {
      "en": "A minimal DUAL-ENGINE test cartridge: the same centred cube and the same plate modelled in OpenSCAD and in CadQuery. Exists so `--parity` is exercised end to end against a pair that genuinely agrees.",
      "es": "Un cartucho de prueba MOTOR DOBLE mínimo: el mismo cubo centrado y la misma placa modelados en OpenSCAD y en CadQuery. Existe para ejercitar `--parity` de extremo a extremo con un par que realmente concuerda."
    },
    "thumbnail": "/projects/dual-block.webp",
    "difficulty": "beginner",
    "tags": [
      "test",
      "fixture",
      "openscad",
      "cadquery",
      "parity",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    }
  },
  "modes": [
    {
      "id": "block",
      "label": {
        "en": "Block",
        "es": "Bloque"
      },
      "scad_file": "block.scad",
      "cq_file": "block.py",
      "parts": [
        "block"
      ],
      "estimate": {
        "base_time": 5,
        "per_unit": 1,
        "per_part": 3
      }
    },
    {
      "id": "plate",
      "label": {
        "en": "Plate",
        "es": "Placa"
      },
      "scad_file": "block.scad",
      "cq_file": "block.py",
      "parts": [
        "plate"
      ],
      "estimate": {
        "base_time": 5,
        "per_unit": 1,
        "per_part": 3
      }
    }
  ],
  "parts": [
    {
      "id": "block",
      "label": {
        "en": "Block",
        "es": "Bloque"
      },
      "render_mode": 0,
      "color": "#8899aa"
    },
    {
      "id": "plate",
      "label": {
        "en": "Plate",
        "es": "Placa"
      },
      "render_mode": 2,
      "color": "#aa8899"
    }
  ],
  "parameters": [
    {
      "id": "block_size",
      "type": "slider",
      "default": 10.0,
      "min": 4.0,
      "max": 40.0,
      "step": 0.5,
      "group": "size",
      "label": {
        "en": "Block size (mm)",
        "es": "Tamaño del bloque (mm)"
      },
      "tooltip": {
        "en": "Edge length of the cube.",
        "es": "Longitud de la arista del cubo."
      }
    },
    {
      "id": "plate_h",
      "type": "slider",
      "default": 2.0,
      "min": 1.0,
      "max": 8.0,
      "step": 0.5,
      "group": "size",
      "modes": [
        "plate"
      ],
      "label": {
        "en": "Plate thickness (mm)",
        "es": "Espesor de la placa (mm)"
      },
      "tooltip": {
        "en": "Thickness of the plate.",
        "es": "Espesor de la placa."
      }
    }
  ],
  "presets": [
    {
      "id": "big_block",
      "mode": "block",
      "label": {
        "en": "Big block",
        "es": "Bloque grande"
      },
      "values": {
        "block_size": 20.0
      }
    }
  ],
  "export_formats": [
    "stl",
    "3mf"
  ],
  "hyperobject": {
    "domain": "tool",
    "cdg_interfaces": [
      {
        "id": "block_face",
        "label": {
          "en": "Block face",
          "es": "Cara del bloque"
        },
        "geometry_type": "plate",
        "standard": "internal",
        "parameters": [
          "block_size"
        ]
      }
    ],
    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": false,
      "tolerance_by_material": false
    },
    "societal_benefit": {
      "en": "None — this is a test fixture, not a design. It exists so cross-kernel parity (`--parity`) is exercised against a real pair of kernels in CI rather than only on the maintainer's laptop.",
      "es": "Ninguno — es un accesorio de prueba, no un diseño. Existe para ejercitar la paridad entre motores (`--parity`) contra un par real de motores en CI y no solo en la máquina del mantenedor."
    },
    "commons_license": "CC0-1.0"
  }
}
