{
  "project": {
    "name": "Graph Twin",
    "slug": "graph-twin",
    "version": "1.0.0",
    "engine": "graph",
    "description": {
      "en": "A GOLDEN-TWIN test cartridge: the same solid authored twice, once as a CadQuery script and once as a node graph, so --parity compares the graph against its script oracle (write-up 3.7).",
      "es": "Un cartucho de prueba GEMELO DORADO: el mismo solido escrito dos veces, como guion CadQuery y como grafo de nodos, para que --parity compare el grafo contra su guion oraculo."
    },
    "thumbnail": "/projects/dual-block.webp",
    "difficulty": "beginner",
    "tags": [
      "test",
      "fixture",
      "graph",
      "parity",
      "golden-twin",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    }
  },
  "modes": [
    {
      "id": "block",
      "label": {
        "en": "Block",
        "es": "Bloque"
      },
      "scad_file": "block.py",
      "parts": [
        "block"
      ],
      "estimate": {
        "base_time": 5,
        "per_unit": 1,
        "per_part": 3
      },
      "cq_file": "block.py",
      "graph_file": "block.graph.json"
    },
    {
      "id": "plate",
      "label": {
        "en": "Plate",
        "es": "Placa"
      },
      "scad_file": "block.py",
      "parts": [
        "plate"
      ],
      "estimate": {
        "base_time": 5,
        "per_unit": 1,
        "per_part": 3
      },
      "cq_file": "block.py",
      "graph_file": "block.graph.json"
    }
  ],
  "parts": [
    {
      "id": "block",
      "label": {
        "en": "Block",
        "es": "Bloque"
      },
      "render_mode": 0,
      "color": "#8899aa"
    },
    {
      "id": "plate",
      "label": {
        "en": "Plate",
        "es": "Placa"
      },
      "render_mode": 2,
      "color": "#aa8899"
    }
  ],
  "parameters": [
    {
      "id": "block_size",
      "type": "slider",
      "default": 10.0,
      "min": 4.0,
      "max": 40.0,
      "step": 0.5,
      "group": "size",
      "label": {
        "en": "Block size (mm)",
        "es": "Tamaño del bloque (mm)"
      },
      "tooltip": {
        "en": "Edge length of the cube.",
        "es": "Longitud de la arista del cubo."
      },
      "binding": [
        "block.w",
        "block.d",
        "block.h"
      ]
    },
    {
      "id": "plate_h",
      "type": "slider",
      "default": 2.0,
      "min": 1.0,
      "max": 8.0,
      "step": 0.5,
      "group": "size",
      "modes": [
        "plate"
      ],
      "label": {
        "en": "Plate thickness (mm)",
        "es": "Espesor de la placa (mm)"
      },
      "tooltip": {
        "en": "Thickness of the plate.",
        "es": "Espesor de la placa."
      },
      "binding": "plate.h"
    }
  ],
  "presets": [
    {
      "id": "big_block",
      "mode": "block",
      "label": {
        "en": "Big block",
        "es": "Bloque grande"
      },
      "values": {
        "block_size": 20.0
      }
    }
  ],
  "export_formats": [
    "stl",
    "3mf"
  ],
  "hyperobject": {
    "domain": "tool",
    "cdg_interfaces": [
      {
        "id": "block_face",
        "label": {
          "en": "Block face",
          "es": "Cara del bloque"
        },
        "geometry_type": "plate",
        "standard": "internal",
        "parameters": [
          "block_size"
        ]
      }
    ],
    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": false,
      "tolerance_by_material": false
    },
    "societal_benefit": {
      "en": "None - this is a test fixture, not a design. It exists so the graph render path is exercised in CI rather than only on the maintainer laptop.",
      "es": "Ninguno - es un accesorio de prueba, no un diseno. Existe para ejercitar la ruta de render de grafos en CI y no solo en la maquina del mantenedor."
    },
    "commons_license": "CC0-1.0"
  }
}