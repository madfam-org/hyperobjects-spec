      "max": 60,
      "step": 1,
      "group": "fit",
      "advanced": true,
      "label": {
        "en": "Back dart intake (mm)",
        "es": "Pinza trasera (mm)",
        "fr": "Profondeur de pince dos (mm)"
      }
    },
    {
      "id": "front_dart_intake",
      "type": "slider",
      "default": 30,
      "min": 0,
      "max": 60,
      "step": 1,
      "group": "fit",
      "advanced": true,
      "label": {
        "en": "Front dart intake (mm)",
        "es": "Pinza delantera (mm)",
        "fr": "Valeur de la pince devant (mm)"
      }
    },
    {
      "id": "seam_allowance",
      "type": "slider",
      "default": 10,
      "min": 0,
      "max": 30,
      "step": 1,
      "group": "construction",
      "label": {
        "en": "Seam allowance (mm)",
        "es": "Margen de costura (mm)",
        "fr": "Marge de couture (mm)"
      }
    },
    {
      "id": "hem_allowance",
      "type": "slider",
      "default": 20,
      "min": 0,
      "max": 60,
      "step": 5,
      "group": "construction",
      "label": {
        "en": "Waist/hem allowance (mm)",
        "es": "Margen de cintura/dobladillo (mm)",
        "fr": "Marge de taille/ourlet (mm)"
      }
    }
  ],
  "presets": [
    {
      "id": "size-s",
      "label": {
        "en": "Size S (84/66)",
        "es": "Talla S (84/66)",
        "fr": "Taille S (84/66)"
      },
      "values": {
        "bust_girth": 840,
        "waist_girth": 660,
        "back_waist_length": 395,
        "neck_girth": 355,
        "shoulder_length": 120
      }
    },
    {
      "id": "size-m",
      "label": {
        "en": "Size M (88/70)",
        "es": "Talla M (88/70)",
        "fr": "Taille M (88/70)"
      },
      "values": {
        "bust_girth": 880,
        "waist_girth": 700,
        "back_waist_length": 400,
        "neck_girth": 370,
        "shoulder_length": 125
      }
    },
    {
      "id": "size-l",
      "label": {
        "en": "Size L (96/80)",
        "es": "Talla L (96/80)",
        "fr": "Taille L (96/80)"
      },
      "values": {
        "bust_girth": 960,
        "waist_girth": 800,
        "back_waist_length": 405,
        "neck_girth": 385,
        "shoulder_length": 130
      }
    }
  ],
  "constraints": [
    {
      "expression": "waist_girth <= bust_girth + 100",
      "severity": "warning",
      "message": {
        "en": "Waist girth is unusually large relative to bust; the draft clamps it",
        "es": "El contorno de cintura es inusualmente grande respecto al busto; el trazo lo limita",
        "fr": "Le tour de taille est inhabituellement grand par rapport à la poitrine ; le tracé le bride"
      }
    },
    {
      "expression": "armscye_depth == 0 || armscye_depth >= 140",
      "severity": "warning",
      "message": {
        "en": "Manual armscye depth below 140 mm will be clamped",
        "es": "Una profundidad de sisa manual menor a 140 mm será limitada",
        "fr": "Une profondeur d'emmanchure manuelle inférieure à 140 mm sera bridée"
      }
    }
  ],
  "export_formats": [
    "svg",
    "dxf",
    "json"
  ],
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "block",
    "interfaces": [
      {
        "id": "neckline",
        "type": "neckline",
        "edges": [
          {
            "piece": "front",
            "edge": "neck"
          },
          {
            "piece": "back",
            "edge": "neck"
          }
        ],
        "parameters": [
          "neck_girth"
        ]
      },
      {
        "id": "armscye",
        "type": "armscye",
        "edges": [
          {
            "piece": "front",
            "edge": "armscye"
          },
          {
            "piece": "back",
            "edge": "armscye"
          }
        ],
        "parameters": [
          "armscye_depth",
          "bust_girth",
          "bust_ease"
        ]
      },
      {
        "id": "waistband",
        "type": "waistband",
        "edges": [
          {
            "piece": "front",
            "edge": "waist"
          },
          {
            "piece": "back",
            "edge": "waist"
          }
        ],
        "parameters": [
          "waist_girth",
          "waist_ease"
        ]
      }
    ],
    "capabilities": {
      "made_to_measure": true,
      "fold_cutting": true,
      "fabric_compensation": false
    },
    "societal_benefit": {
      "en": "The bodice sloper is the literacy primitive of garment making: drafted to real body measurements it replaces standardized sizing with fit, reduces fabric waste from mis-sized patterns, and gives every downstream Fashion Cabinet garment a verified foundation.",
      "es": "El patrón base de corpiño es la primitiva de alfabetización de la confección: trazado con medidas corporales reales sustituye el tallaje estandarizado por el ajuste, reduce el desperdicio de tela por patrones de talla errónea y da a cada prenda de Fashion Cabinet una base verificada.",
      "fr": "Le patron de base de corsage est la primitive d'alphabétisation de la confection : tracé à de vraies mesures corporelles, il remplace le tallage standardisé par l'ajustement, réduit le gaspillage de tissu dû aux patrons mal dimensionnés, et donne à chaque vêtement Fashion Cabinet en aval une base vérifiée."
    },
    "commons_license": "LicenseRef-FC1-pending"
  }
}
