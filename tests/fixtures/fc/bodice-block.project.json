{
  "project": {
    "name": "Bodice Block (Sloper)",
    "slug": "bodice-block",
    "version": "0.1.0",
    "engine": "fc",
    "description": {
      "en": "A simplified metric bodice sloper drafted from body measurements: front and back pieces with waist darts, matched side and shoulder seams, fold-cut center lines, notches, and grainlines. The foundational block every fitted garment starts from.\n\nOfficial visualizer and configurator: Fashion Cabinet",
      "es": "Un patrón base de corpiño métrico simplificado trazado a partir de medidas corporales: piezas delantera y trasera con pinzas de cintura, costuras laterales y de hombro emparejadas, líneas centrales al doblez, piquetes y sentido de hilo. El bloque fundamental del que parte toda prenda entallada.\n\nVisualizador y configurador oficial: Fashion Cabinet",
      "fr": "Un patron de base de corsage métrique simplifié tracé à partir de mesures corporelles : pièces devant et dos avec pinces de taille, coutures de côté et d'épaule appariées, lignes centrales au pli, crans et droits-fil. Le bloc fondamental d'où part tout vêtement ajusté.\n\nVisualiseur et configurateur officiel : Fashion Cabinet"
    },
    "difficulty": "intermediate",
    "tags": [
      "bodice",
      "sloper",
      "block",
      "made-to-measure",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "LicenseRef-FC1-pending",
      "lineage": [
        {
          "source": "Original draft for Fashion Cabinet; simplified flat block informed by standard metric pattern-drafting practice",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "sloper",
      "label": {
        "en": "Sloper (front + back)",
        "es": "Patrón base (delantero + trasero)",
        "fr": "Patron de base (devant + dos)"
      },
      "script_file": "main.py",
      "pieces": [
        "front",
        "back"
      ]
    }
  ],
  "pieces": [
    {
      "id": "front",
      "label": {
        "en": "Front Bodice",
        "es": "Corpiño Delantero",
        "fr": "Corsage devant"
      },
      "default_color": "#c96f4a",
      "cut": {
        "quantity": 1,
        "on_fold": true,
        "mirror": true
      }
    },
    {
      "id": "back",
      "label": {
        "en": "Back Bodice",
        "es": "Corpiño Trasero",
        "fr": "Corsage dos"
      },
      "default_color": "#4a7fc9",
      "cut": {
        "quantity": 1,
        "on_fold": true,
        "mirror": true
      }
    }
  ],
  "parameter_groups": [
    {
      "id": "body",
      "label": {
        "en": "Body Measurements",
        "es": "Medidas Corporales",
        "fr": "Mesures corporelles"
      }
    },
    {
      "id": "fit",
      "label": {
        "en": "Ease & Fit",
        "es": "Holgura y Ajuste",
        "fr": "Aisance et ajustement"
      }
    },
    {
      "id": "construction",
      "label": {
        "en": "Construction",
        "es": "Construcción",
        "fr": "Montage"
      }
    }
  ],
  "parameters": [
    {
      "id": "bust_girth",
      "type": "slider",
      "default": 880,
      "min": 600,
      "max": 1600,
      "step": 5,
      "group": "body",
      "measurement": {
        "standard": "iso_8559",
        "code": "bust_girth"
      },
      "label": {
        "en": "Bust girth (mm)",
        "es": "Contorno de busto (mm)",
        "fr": "Tour de buste (mm)"
      }
    },
    {
      "id": "waist_girth",
      "type": "slider",
      "default": 700,
      "min": 450,
      "max": 1500,
      "step": 5,
      "group": "body",
      "measurement": {
        "standard": "iso_8559",
        "code": "waist_girth"
      },
      "label": {
        "en": "Waist girth (mm)",
        "es": "Contorno de cintura (mm)",
        "fr": "Tour de taille (mm)"
      }
    },
    {
      "id": "back_waist_length",
      "type": "slider",
      "default": 400,
      "min": 280,
      "max": 560,
      "step": 5,
      "group": "body",
      "measurement": {
        "standard": "iso_8559",
        "code": "back_neck_to_waist"
      },
      "label": {
        "en": "Nape to waist (mm)",
        "es": "Largo de talle espalda (mm)",
        "fr": "Nuque à la taille (mm)"
      }
    },
    {
      "id": "neck_girth",
      "type": "slider",
      "default": 370,
      "min": 280,
      "max": 520,
      "step": 5,
      "group": "body",
      "measurement": {
        "standard": "iso_8559",
        "code": "neck_girth"
      },
      "label": {
        "en": "Neck girth (mm)",
        "es": "Contorno de cuello (mm)",
        "fr": "Tour de cou (mm)"
      }
    },
    {
