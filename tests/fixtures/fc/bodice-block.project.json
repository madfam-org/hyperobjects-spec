        "fr": "Longueur d'épaule (mm)"
      }
    },
    {
      "id": "armscye_depth",
      "type": "slider",
      "default": 0,
      "min": 0,
      "max": 320,
      "step": 5,
      "group": "body",
      "advanced": true,
      "label": {
        "en": "Armscye depth (mm, 0 = auto)",
        "es": "Profundidad de sisa (mm, 0 = auto)",
        "fr": "Profondeur d'emmanchure (mm, 0 = auto)"
      }
    },
    {
      "id": "bust_ease",
      "type": "slider",
      "default": 80,
      "min": 0,
      "max": 200,
      "step": 5,
      "group": "fit",
      "label": {
        "en": "Bust ease (mm)",
        "es": "Holgura de busto (mm)",
        "fr": "Aisance de poitrine (mm)"
      }
    },
    {
      "id": "waist_ease",
      "type": "slider",
      "default": 60,
      "min": 0,
      "max": 200,
      "step": 5,
      "group": "fit",
      "label": {
        "en": "Waist ease (mm)",
        "es": "Holgura de cintura (mm)",
        "fr": "Aisance de taille (mm)"
      }
    },
    {
      "id": "back_dart_intake",
